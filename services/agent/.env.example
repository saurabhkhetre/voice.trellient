# =============================================================
# Voice agent worker -- environment variables
# =============================================================
# Copy to .env and fill in. Loaded automatically via python-dotenv
# (see voice_agent/main.py).

# Local Postgres (see docker-compose.yml + scripts/db-init.mjs at repo root)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trellient

# LiveKit (same project as the frontend's .env)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# At least one realtime provider key
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional overrides (defaults live in voice_agent/config.py)
# REALTIME_PROVIDER=openai_realtime
# REALTIME_MODEL=gpt-realtime
# AGENT_VOICE=alloy
# AGENT_GREETING=Hi, thanks for calling. How can I help you today?
