# =============================================================
# Trellient Voice SaaS -- environment variables
# =============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is in .gitignore.

# ---- Postgres (all app data, accounts and sessions) ----
# Local defaults match docker-compose.yml; scripts/db-init.mjs creates the
# schema and seeds the dev sign-in dev@trellient.local / trellient-dev.
#
# Two forms of the same database, because two runtimes read it: the Node app
# and the Python agent take the postgres:// URI, Spring Boot takes JDBC. They
# must point at the same database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trellient
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/trellient
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ---- LiveKit (server-side only) ----
# Get from: https://cloud.livekit.io → Project → Settings → Keys
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- AI Provider (server-side, used by the Python agent only) ----
# At least ONE of these is required, depending on which provider(s) your agents use.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Python Agent Config (server-side) ----
# REALTIME_PROVIDER=openai_realtime       # or gemini_live
# REALTIME_MODEL=gpt-realtime
# AGENT_VOICE=alloy
# AGENT_GREETING=Hi, thanks for calling. How can I help you today?
# DEFAULT_BUSINESS_ID=                    # fallback when room metadata has no business_id

# ---- Telephony (server-side only) ----
TELEPHONY_WEBHOOK_TOKEN=
# Exotel (default provider)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
# LiveKit SIP outbound trunk for outbound calls when a number has no trunk of its own
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Telnyx (alternative provider)
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=

# ---- Spring Boot API (services/api) ----
# JDBC_DATABASE_URL, DATABASE_USERNAME and DATABASE_PASSWORD are at the top
# with the other database settings — the API will not start without them.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#
# Must be true anywhere the app is served over HTTPS: it sets Secure on the
# session cookie. Startup fails if this is left false outside the dev profile.
APP_SESSION_SECURE_COOKIE=false

# ---- Dev seed (scripts/db-init.mjs) ----
# Override the seeded sign-in. Defaults shown; the ids are constants in the
# script, not environment variables.
# DEV_EMAIL=dev@trellient.local
# DEV_PASSWORD=trellient-dev

# ---- Optional ----
# VITE_ANALYTICS_ID=           # Plausible / Fathom snippet ID
