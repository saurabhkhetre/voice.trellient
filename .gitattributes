# Normalise to LF in the repo AND in the working tree on every platform.
# Without eol=lf, core.autocrlf=true hands Windows a CRLF tree and prettier
# reports thousands of phantom "Delete CR" warnings that bury real findings.
* text=auto eol=lf

# Keep binaries byte-exact.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.jar binary
*.mp3 binary
*.wav binary

# Generated — collapse in diffs and reviews.
package-lock.json linguist-generated=true -diff
*.gen.ts linguist-generated=true
