# Voice agent (server-side only — never ship these to a browser)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Realtime AI provider
REALTIME_PROVIDER=openai_realtime
OPENAI_API_KEY=
REALTIME_MODEL=gpt-4o-realtime-preview
AGENT_VOICE=alloy
AGENT_GREETING=Hey, I'm your voice assistant. What would you like to talk about?

# Reserved for the (not yet implemented) Gemini Live provider
# GOOGLE_API_KEY=

LOG_LEVEL=INFO

# Business data (Supabase) — service role key stays server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used for browser test calls when no telephony metadata is present
DEFAULT_BUSINESS_ID=

# Telephony (Exotel) — set once the account exists
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
TELEPHONY_WEBHOOK_TOKEN=
